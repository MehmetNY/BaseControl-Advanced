#include <winver.h>
#include "version_res.h"

1 ICON "app.ico"
1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION BC_VER_NUM
PRODUCTVERSION BC_VER_NUM
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "MehmetNY"
      VALUE "FileDescription", "BaseControl Advanced"
      VALUE "FileVersion", BC_VER_STR
      VALUE "InternalName", "BaseControl"
      VALUE "LegalCopyright", "GPL-3.0-or-later"
      VALUE "OriginalFilename", "BaseControl.exe"
      VALUE "ProductName", "BaseControl Advanced"
      VALUE "ProductVersion", BC_VER_STR
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
