# Windows build (cross-compiled with mingw-w64):   make -f Makefile.win -j8
#   VERSION=1.0.0 overrides the version string.  Output: build/win/BaseControl.exe
CXX     := x86_64-w64-mingw32-g++
WINDRES := x86_64-w64-mingw32-windres
STRIP   := x86_64-w64-mingw32-strip
VERSION ?= 1.0.0
VER_NUM := $(shell echo $(VERSION) | awk -F. '{printf "%d,%d,%d,0", $$1, $$2, $$3}')

CXXFLAGS := -std=c++17 -O2 -Wall -Wextra -Wpedantic -Wshadow -D__USE_MINGW_ANSI_STDIO=1 -DBC_VERSION=\"$(VERSION)\" -Isrc
LDFLAGS  := -static -static-libgcc -static-libstdc++ -mwindows -Wl,--nxcompat -Wl,--dynamicbase -Wl,--high-entropy-va -Wl,--no-insert-timestamp
LDLIBS   := -lgdiplus -lsetupapi -lhid -lwlanapi -lpowrprof -lversion -lshell32 -lole32 -loleaut32 -luuid -luser32 -lgdi32 -ladvapi32 -lcomctl32 -lshlwapi -luxtheme -lwinmm -lbcrypt -lcrypt32 -lcomdlg32 -ldwmapi

SRC := src/main.cpp $(wildcard src/common/*.cpp) $(wildcard src/mgp/core/*.cpp) $(wildcard src/mgp/win/*.cpp) \
       $(wildcard src/hw/*.cpp) $(wildcard src/svc/*.cpp) $(wildcard src/sim/*.cpp) $(wildcard src/ui/*.cpp)
OBJ := $(patsubst src/%.cpp,build/win/obj/%.o,$(SRC))
EXE := build/win/BaseControl.exe

all: $(EXE)

build/win/obj/%.o: src/%.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -MMD -MP -c $< -o $@

build/win/version_res.h: Makefile.win
	@mkdir -p $(dir $@)
	printf '#define BC_VER_NUM %s\n#define BC_VER_STR "%s"\n' "$(VER_NUM)" "$(VERSION)" > $@

build/win/obj/res.o: res/app.rc res/app.ico res/app.manifest build/win/version_res.h
	@mkdir -p $(dir $@)
	$(WINDRES) -Ires -Ibuild/win -O coff $< $@

$(EXE): $(OBJ) build/win/obj/res.o
	$(CXX) $(LDFLAGS) -o $@ $^ $(LDLIBS)
	SOURCE_DATE_EPOCH=0 $(STRIP) --strip-all -o build/win/BaseControl.min.exe $@   # the release binary: no COFF symbol table (tools/verify_pe.py checks it); a fixed timestamp keeps it byte-identical whichever directory builds it
	@ls -l $@ build/win/BaseControl.min.exe

clean:
	rm -rf build/win

-include $(OBJ:.o=.d)
.PHONY: all clean
